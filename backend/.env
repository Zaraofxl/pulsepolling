# ============================================================================
# PULSEPOLL BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================

# HTTP Server Port
PORT=8080

# MongoDB Connection (Local or Atlas URI)
# Example: mongodb://localhost:27017 or mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb+srv://pulseadmin:Pollpass%40123@pulsepoll.wzxqp9i.mongodb.net/pulsepoll_db?retryWrites=true&w=majority&appName=pulsepoll
MONGODB_NAME=pulsepoll_db

# Redis Connection (Local or Cloud/Upstash)
# Example: localhost:6379 or your-redis.upstash.io:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication Secret Key
JWT_SECRET=pulsepoll-production-grade-hmac-sha256-secret-key-9912487
JWT_EXPIRY_HOURS=72

# Permitted Client CORS Origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Fallback Mode (true: automatically fallbacks to in-memory store if DB/Redis unavailable)
FALLBACK_MODE=true
