# Environment variables & secrets (CRITICAL: never commit to Git)
.env
.env.*
*.env
backend/.env
frontend/.env.production
frontend/.env.local

# Allow example config templates
!.env.example
!.env.*.example
!backend/.env.example
!backend/.env.render.example
!frontend/.env.production.example

# Compiled binaries and executables
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
server
backend/server.exe
backend-server.exe

# Node & Frontend dependencies and build artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
